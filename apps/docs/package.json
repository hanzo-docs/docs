    "@next/env": "16.2.12",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "browserslist-config-baseline": "^0.5.0",
    "mcp-handler": "^1.1.0",
    "next-validate-link": "^1.6.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-morph": "^28.0.0",
