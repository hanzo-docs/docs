{
  "name": "docs",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "build": "pnpm build:pre && pnpm gen:collections && next build && pnpm build:post",
    "build:pre": "bun ./scripts/pre-build.ts",
    "build:post": "bun ./scripts/post-build.ts",
    "sync:mcp": "bun ./scripts/sync-mcp-tools.ts",
    "types:check": "docs-mdx && next typegen && tsc --noEmit",
    "clean": "rimraf .next",
    "dev": "next dev",
    "lint": "docs-mdx && bun ./scripts/lint.entry.ts",
    "start": "next start",
    "gen:collections": "node --input-type=module -e \"const m=await import('@hanzo/docs-mdx/next'); await m.postInstall({configPath:'source.config.ts'})\""
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
    "@ai-sdk/react": "catalog:",
    "@hanzo/ai": "catalog:",
    "@hanzo/brand": "catalog:",
