{
  "name": "docs",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "build": "pnpm build:pre && pnpm gen:collections && next build && pnpm build:post",
    "build:pre": "bun ./scripts/gen-services-nav.ts && bun ./scripts/pre-build.ts",
    "build:post": "bun ./scripts/post-build.ts",
    "gen:services": "bun ./scripts/gen-services-nav.ts",
    "types:check": "docs-mdx && next typegen && tsc --noEmit",
    "clean": "rimraf .next",
    "dev": "next dev",
    "lint": "docs-mdx && bun ./scripts/lint.entry.ts",
    "start": "next start",
    "gen:collections": "node --input-type=module -e \"const m=await import('@hanzo/docs-mdx/next'); await m.postInstall({configPath:'source.config.ts',outDir:'docs'})\""
  },
  "dependencies": {
    "@hanzo/docs-analytics": "workspace:*",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/react": "^3.0.193",
    "@hanzo/ai": "^0.2.2",
    "@hanzo/brand": "^1.4.1",
    "@hanzo/docs": "workspace:*",
    "@hanzo/docs-base-ui": "workspace:*",
    "@hanzo/docs-core": "workspace:*",
    "@hanzo/docs-docgen": "workspace:^",
    "@hanzo/docs-epub": "workspace:*",
    "@hanzo/docs-mdx": "workspace:*",
    "@hanzo/docs-openapi": "workspace:^",
    "@hanzo/docs-sanity": "workspace:*",
    "@hanzo/docs-story": "workspace:*",
    "@hanzo/docs-twoslash": "workspace:^",
    "@hanzo/docs-typescript": "workspace:^",
    "@hanzo/docs-ui": "workspace:*",
    "@hanzo/iam": "^0.21.6",
    "@hanzo/logo": "^1.0.14",
    "@hanzogui/shell": "^7.6.3",
    "@llmgateway/ai-sdk-provider": "^3.8.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@orama/core": "^1.2.19",
    "@paper-design/shaders-react": "^0.0.76",
    "@radix-ui/react-presence": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/transformers": "^4.1.0",
    "@takumi-rs/image-response": "^1.6.0",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "d3-force": "^3.0.0",
    "estree-util-build-jsx": "^3.0.1",
    "estree-util-to-js": "^2.0.0",
    "feed": "^5.2.1",
    "flexsearch": "^0.8.212",
    "fuma-cli": "^0.1.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "0.17.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "motion": "^12.40.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.5",
    "oxc-transform": "^0.133.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.1.0",
