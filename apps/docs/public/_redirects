# Cloudflare Pages redirects — the single source of truth for docs.hanzo.ai
# HTTP redirects. This site deploys as a static export (`out/`), which ignores
# next.config `redirects()`, so this file is what runs in production — exactly
# like the sibling public/_headers.

# API reference: the canonical page is the single-page OpenAPI reference at
# /docs/openapi. Send every intuitive/guessed alias there so it always resolves.
/docs/api          /docs/openapi          301
/docs/api/*        /docs/openapi          301
/api               /docs/openapi          301
/api/*             /docs/openapi          301
/api-reference     /docs/openapi          301
/api-reference/*   /docs/openapi          301

# Hanzo Storage had two skill pages for one product (hanzoai/s3). The page
# named after the repo is canonical.
/docs/skills/hanzo-storage /docs/openapi/s3       301

# The object store is Hanzo S3 (hanzoai/s3), documented at /docs/services/s3.
# These two pages are gone; the source paths below are the URLs they were
# published at, so they have to stay spelled that way to catch old links.
/docs/services/iam/integration/go/minio /docs/openapi/s3       301
/docs/services/iam/provider/storage/minio /docs/openapi/s3       301

# hanzoai/logs is archived (retired Loki import). Log ingest runs on o11y.
/docs/skills/hanzo-logs /docs/openapi/o11y     301

# Tutorials were merged into Services.
/tutorials         /docs/start            301
/tutorials/*       /docs/services/:splat  301

# Top-level convenience aliases. docs.hanzo.ai is already the docs subdomain, so
# bare product paths resolve to their canonical page under /docs. Explicit list
# only — never a catch-all, which would shadow /, /blog, /showcase, /login.
/introduction      /docs/quickstart       301
/quickstart        /docs/quickstart       301
/getting-started   /docs/quickstart       301
/models            /docs/openapi/ai       301
/chat              /docs/chat             301
/agents            /docs/openapi/agents   301
/mcp               /docs/mcp              301
/sdks              /docs/sdks             301
/llm               /docs/openapi/ai       301
/network           /docs/network          301
/self-host         /docs/network          301
/node              /docs/proof-of-ai/node-operator  301

# hanzo.ai CTAs linked bare /network, /node and /self-host plus a /quickstart
# child under each; neither child ever had a page. The canonical page in each
# case opens with its own start steps — /docs/network is the self-host story
# ("the AI cloud you can run yourself") and the Node Operator Guide is how you
# run a node — so the guessed children resolve to the page itself rather than to
# a thin duplicate.
/network/quickstart  /docs/network                    301
/node/quickstart     /docs/proof-of-ai/node-operator  301

# Console product "Docs" deep-links (console registry uses /docs/<product>).
# Where the canonical page lives under /docs/services or /docs/projects, alias it
# so the console's Docs button always resolves.
/docs/analytics    /docs/openapi/event    301
/docs/auto         /docs/openapi/auto     301
/docs/cms          /docs/projects/hanzoai/cms       301
/docs/helpdesk     /docs/projects/hanzoai/helpdesk  301
/docs/apm          /docs/openapi/o11y     301
/docs/apps         /docs/services/paas              301
/docs/nodes        /docs/openapi/visor    301
/docs/dns          /docs/openapi/dns      301
/docs/desktop      /docs/apps/desktop               301
/docs/code         /docs/openapi/code     301

# The console links the SDK product at the singular /docs/sdk; the section is
# /docs/sdks. Catch the singular rather than move the section.
/docs/sdk          /docs/sdks                       301

# Collapsed / renamed product slugs → canonical page (V8 product consolidation).
# Old console/product slugs kept resolving so no deep-link 404s post-merge. Only
# listed where a canonical page exists; ads→marketing and cms→content are omitted
