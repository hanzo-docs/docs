out
.open-next
.dev.vars
# The API reference is generated from the document on every build — including
# its index, whose product list and counts are the document's, not ours.
content/docs/openapi/

# OpenAPI specs are the committed CI snapshot: scripts/sync-openapi.sh refreshes
# them from the (private) hanzoai/openapi repo locally, but CI cannot clone that
# repo and falls back to these checked-in copies. They are TRACKED, not ignored —
# ignoring them silently drops newly-added services from the snapshot. Re-run the
# sync, then commit the diff so the snapshot stays current.

public/r
public/registry

# Synced project docs (generated by sync-project-docs.ts)
content/docs/projects/
# The document is fetched by scripts/sync-openapi.sh and copied to public/
# at build time — one document, one copy in git.
public/openapi/

# The operator surface: one page per /v1/admin operation, generated beside the
# public reference and deliberately NOT under content/, so nothing routes it.
# Ignored because this repository is public — see INTERNAL_DIR in
# scripts/gen-openapi-pages.ts for where these pages are meant to end up.
internal/

# Generated flow pages (six journeys x four surfaces) — see scripts/gen-flow-pages.ts
content/docs/start/

# Generated MCP reference (one page per tool) — see scripts/gen-mcp-pages.ts.
# The tool list it renders from IS tracked (openapi-specs/mcp-tools.json).
content/docs/mcp-tools/

# Generated pricing page — see scripts/gen-pricing-page.ts. Every rate on it is
# read from /v1/pricing; the snapshot it renders from IS tracked
# (openapi-specs/pricing.json), so a builder with no egress still gets the page.
content/docs/pricing.mdx
