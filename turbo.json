{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "HANZO_PUBLISHABLE_KEY",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_APP_ID",
    "GITHUB_TOKEN",
    "GH_TOKEN",
    "GH_PAT",
    "DOCS_SECTION",
    "GITHUB_PAGES",
    "NEXT_EXPORT",
    "HIPS_REPO_DIR",
    "HANZO_DOCS_SYNC",
    "HANZO_DOCS_LOCAL_ROOT",
    "HANZO_DOCS_ORGS",
    "HANZO_DOCS_PRUNE",
    "HANZO_DOCS_DRY_RUN",
    "HANZO_DOCS_CONCURRENCY",
    "HANZO_DOCS_FETCH_REMOTE",
    "HANZO_DOCS_INCLUDE_PRIVATE",
    "HANZO_SEARCH_BACKEND",
    "HANZO_SEARCH_INDEX",
    "HANZO_SEARCH_INDEX_ENDPOINT",
    "HANZO_SEARCH_ADMIN_KEY"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".output",
        "public/registry",
        ".docs/**",
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "css/generated/**",
        "out",
        "build",
        ".vercel"
      ]
    },
    "lint": {},
    "types:check": {
      "dependsOn": [],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
