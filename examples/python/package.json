{
  "name": "example-python",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm build:docs && next build",
    "dev": "next dev",
    "start": "next start",
    "build:docs": "pnpm python:generate && node ./scripts/generate-docs.mjs",
    "python:generate": "pip3 install ./node_modules/@hanzo/docs-python && hanzodocs-py-generate httpx",
    "types:check": "@hanzo/docs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@hanzo/docs-core": "workspace:*",
    "@hanzo/docs-mdx": "workspace:*",
    "@hanzo/docs-python": "workspace:*",
    "@hanzo/docs-ui": "workspace:*",
    "@hanzo/font": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
