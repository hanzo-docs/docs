    "picocolors": "catalog:",
    "rehype-raw": "catalog:",
    "picomatch": "catalog:",
    "tinyexec": "catalog:",
    "tinyglobby": "catalog:",
    "unified": "catalog:",
    "unist-util-remove-position": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hanzo/docs-vite": "workspace:*",
    "@types/bun": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/mdast": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/react": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "mdast-util-directive": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "remark": "catalog:",
    "remark-directive": "catalog:",
    "remark-mdx": "catalog:",
    "rolldown": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "webpack": "catalog:"
  },
  "peerDependencies": {
    "@types/mdast": ">=4",
    "@types/mdx": ">=2",
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "mdast-util-directive": ">=3",
    "next": ">=16.3.3",
    "react": ">=19.2.8",
    "rolldown": ">=1",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "mdast-util-directive": {
      "optional": true
