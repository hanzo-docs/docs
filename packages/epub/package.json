{
  "name": "@hanzo/docs-epub",
  "version": "1.0.0",
  "description": "EPUB export for Hanzo Docs",
  "keywords": [
    "documentation",
    "epub",
    "export",
    "hanzo-docs"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "repository": "github:hanzoai/docs",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "epub-gen-memory": "catalog:",
    "rehype-stringify": "catalog:",
    "remark": "catalog:",
    "remark-gfm": "catalog:",
    "remark-rehype": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "rimraf": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vfile": "catalog:"
  },
  "peerDependencies": {
    "@hanzo/docs-core": ">=17.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
