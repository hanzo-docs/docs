{
  "name": "@hanzo/docs-python",
  "version": "0.0.9",
  "description": "The built-in Python docgen for Hanzo Docs",
  "keywords": [
    "Docs",
    "NextJs",
    "Python"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "files": [
    "hanzodocs_py",
    "pyproject.toml",
    "styles",
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./preset.css": "./styles/preset.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "js-yaml": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "@hanzo/docs-ui": "workspace:*",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "@hanzo/docs-ui": ">=17.0.5",
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
