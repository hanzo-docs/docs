{
  "name": "@hanzo/docs-docgen",
  "version": "3.1.2",
  "description": "Useful remark utilities and plugins",
  "keywords": [
    "Docs",
    "Hanzo Docs",
    "mdx",
    "remark"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remark-ts2js": {
      "types": "./dist/remark-ts2js.d.ts",
      "import": "./dist/remark-ts2js.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "estree-util-to-js": "catalog:",
    "estree-util-value-to-estree": "catalog:",
    "npm-to-yarn": "catalog:",
    "oxc-transform": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/mdx": "catalog:",
    "@types/estree": "catalog:",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "mdast-util-mdx": "catalog:",
    "remark": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/estree": ">=1",
    "@types/hast": ">=3",
    "@types/mdast": ">=4",
    "@hanzo/docs-core": ">=17.0.1",
    "mdast-util-mdx": ">=3"
  },
  "peerDependenciesMeta": {
    "mdast-util-mdx": {
      "optional": true
    },
    "@types/hast": {
      "optional": true
    },
    "@types/mdast": {
      "optional": true
    },
    "@types/estree": {
      "optional": true
    }
  }
}
