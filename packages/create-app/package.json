{
  "name": "@hanzo/create-docs",
  "version": "16.0.119",
  "description": "Create a new documentation site with Hanzo Docs",
  "keywords": [
    "Docs",
    "Hanzo Docs",
    "react"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "bin": "./dist/bin.js",
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run sync && tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit",
    "sync": "node ./scripts/sync.ts"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@commander-js/extra-typings": "catalog:",
    "@hanzo/docs-cli": "workspace:*",
    "commander": "catalog:",
    "fuma-cli": "catalog:",
    "picocolors": "catalog:",
    "tinyexec": "catalog:",
    "ts-morph": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "tinyglobby": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
