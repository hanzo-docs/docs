{
  "name": "@hanzo/docs-sanity",
  "version": "0.0.5",
  "description": "The official Sanity integration for Hanzo Docs",
  "keywords": [
    "Docs",
    "Hanzo Docs"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/react": "catalog:"
  },
  "devDependencies": {
    "@sanity/client": "catalog:",
    "@sanity/types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "fuma-cli": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "@hanzo/docs-ui": "workspace:*",
    "next-sanity": "catalog:",
    "react": "catalog:",
    "sanity": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@sanity/client": ">=8",
    "@sanity/types": ">=6",
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "next-sanity": ">=13",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@sanity/types": {
      "optional": true
    },
    "@sanity/client": {
      "optional": true
    },
    "next-sanity": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
