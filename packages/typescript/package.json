{
  "name": "@hanzo/docs-typescript",
  "version": "5.2.0",
  "description": "Typescript Integration for Hanzo Docs",
  "keywords": [
    "Docs",
    "NextJs",
    "Hanzo Docs"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "estree-util-value-to-estree": "catalog:",
    "hast-util-to-estree": "catalog:",
    "hast-util-to-jsx-runtime": "catalog:",
    "remark": "catalog:",
    "remark-rehype": "catalog:",
    "shiki": "catalog:",
    "ts-morph": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/mdx": "catalog:",
    "@types/estree": "catalog:",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "@hanzo/docs-ui": "workspace:*",
    "mdast-util-mdx": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vfile": "catalog:"
  },
  "peerDependencies": {
    "@types/estree": ">=1",
    "@types/hast": ">=3",
    "@types/mdast": ">=4",
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "@hanzo/docs-ui": ">=17.0.5",
    "react": ">=19.2.8",
    "shiki": ">=4",
    "typescript": ">=7.0.2"
  },
  "peerDependenciesMeta": {
    "@types/estree": {
      "optional": true
    },
    "@types/hast": {
      "optional": true
    },
    "@types/mdast": {
      "optional": true
    },
    "@hanzo/docs-ui": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
