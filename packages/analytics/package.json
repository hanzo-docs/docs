{
  "name": "@hanzo/docs-analytics",
  "version": "0.1.0",
  "description": "The ONE telemetry drop-in for every Hanzo docs site \u2014 @hanzo/event to POST /v1/event.",
  "private": true,
  "license": "MIT",
  "author": "Hanzo AI",
  "repository": "github:hanzo-docs/docs",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hanzo/event": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "next": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "next": ">=16.3.3",
    "react": ">=19.2.8"
  }
}
