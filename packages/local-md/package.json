{
  "name": "@hanzo/docs-local-md",
  "version": "0.2.3",
  "description": "The local Markdown files content source for Hanzo Docs",
  "keywords": [
    "Docs",
    "Hanzo Docs"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "bin": {
    "local-md": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./dev/node-client": "./dist/dev/node-client.js",
    "./dev/node-server": "./dist/dev/node-server.js",
    "./dev/react-client": "./dist/dev/react-client.js",
    "./js/executor": "./dist/js/executor.js",
    "./js/executor-native": "./dist/js/executor-native.js",
    "./js/executor-virtual": "./dist/js/executor-virtual.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "catalog:",
    "@standard-schema/spec": "catalog:",
    "chokidar": "catalog:",
    "commander": "catalog:",
    "estree-util-build-jsx": "catalog:",
    "estree-util-to-js": "catalog:",
    "hast-util-to-jsx-runtime": "catalog:",
    "picomatch": "catalog:",
    "remark": "catalog:",
    "remark-rehype": "catalog:",
    "tinyglobby": "catalog:",
    "vfile": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/estree": "catalog:",
    "@types/estree-jsx": "catalog:",
    "@types/hast": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unist": "catalog:",
    "@types/ws": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "unified": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@types/estree": ">=1",
    "@types/estree-jsx": ">=1",
    "@types/hast": ">=3",
    "@types/mdx": ">=2",
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8",
    "unified": ">=11"
  },
  "peerDependenciesMeta": {
    "unified": {
      "optional": true
    },
    "@types/mdx": {
      "optional": true
    },
    "@types/estree": {
      "optional": true
    },
    "@types/estree-jsx": {
      "optional": true
    },
    "@types/hast": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
