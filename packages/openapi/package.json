{
  "name": "@hanzo/docs-openapi",
  "version": "10.10.0",
  "description": "Generate MDX docs for your OpenAPI spec",
  "keywords": [
    "Docs",
    "NextJs"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "files": [
    "css",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./i18n": "./dist/i18n.js",
    "./playground/client": "./dist/playground/client.js",
    "./requests/generators": "./dist/requests/generators/index.js",
    "./requests/generators/all": "./dist/requests/generators/all.js",
    "./requests/generators/csharp": "./dist/requests/generators/csharp.js",
    "./requests/generators/curl": "./dist/requests/generators/curl.js",
    "./requests/generators/go": "./dist/requests/generators/go.js",
    "./requests/generators/java": "./dist/requests/generators/java.js",
    "./requests/generators/javascript": "./dist/requests/generators/javascript.js",
    "./requests/generators/python": "./dist/requests/generators/python.js",
    "./scalar": "./dist/scalar/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./ui/base": "./dist/ui/base.js",
    "./ui/client": "./dist/ui/client/index.js",
    "./ui/create-client": "./dist/ui/create-client.js",
    "./package.json": "./package.json",
    "./css/*": "./css/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fumari/json-schema-ts": "catalog:",
    "@hanzo/docs-base-ui": "workspace:*",
    "@hanzo/docs-stf": "workspace:*",
    "@radix-ui/react-accordion": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "chokidar": "catalog:",
    "class-variance-authority": "catalog:",
    "github-slugger": "catalog:",
    "hast-util-to-jsx-runtime": "catalog:",
    "js-yaml": "catalog:",
    "lucide-react": "catalog:",
    "remark": "catalog:",
    "remark-rehype": "catalog:",
    "shiki": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@fastify/deepmerge": "catalog:",
    "@scalar/api-client-react": "catalog:",
    "@scalar/json-magic": "catalog:",
    "@scalar/openapi-upgrader": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "ajv": "catalog:",
    "fast-content-type-parse": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "@hanzo/docs-ui": "workspace:*",
    "json-schema-typed": "catalog:",
    "tailwindcss": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "xml-js": "catalog:"
  },
  "peerDependencies": {
    "@scalar/api-client-react": ">=2",
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "@hanzo/docs-ui": ">=17.0.5",
    "json-schema-typed": ">=8",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "json-schema-typed": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@scalar/api-client-react": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@fastify/deepmerge": "3.2.1",
    "@scalar/helpers": "0.8.0",
    "@scalar/json-magic": "0.12.14",
    "@scalar/openapi-upgrader": "0.2.8",
    "ajv": "8.20.0",
    "fast-content-type-parse": "3.0.0",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "3.1.0",
    "json-schema-traverse": "1.0.0",
    "pathe": "2.0.3",
    "xml-js": "1.6.11",
    "yaml": "2.9.0"
  }
}
