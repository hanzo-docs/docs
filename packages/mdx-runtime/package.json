{
  "name": "@hanzo/mdx-runtime",
  "version": "1.6.1",
  "description": "Runtime MDX compilation and execution for Hanzo Docs",
  "keywords": [
    "Docs",
    "NextJs",
    "hanzo-docs",
    "next-mdx-remote"
  ],
  "homepage": "https://hanzo.ai/docs",
  "license": "MIT",
  "author": "Hanzo AI",
  "repository": "github:hanzoai/docs",
  "files": [
    "dist/*"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "catalog:",
    "gray-matter": "catalog:",
    "unified": "catalog:",
    "vfile": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "react": "catalog:",
    "tinyglobby": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
