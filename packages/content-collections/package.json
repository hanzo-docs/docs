{
  "name": "@hanzo/docs-content-collections",
  "version": "1.2.7",
  "description": "The Content Collections adapter for Hanzo Docs",
  "keywords": [
    "Content Collections",
    "Docs",
    "NextJs"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "import": "./dist/configuration.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "unified": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@content-collections/core": "catalog:",
    "@content-collections/mdx": "catalog:",
    "@types/node": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@content-collections/core": ">=0",
    "@content-collections/mdx": ">=0",
    "@hanzo/docs-core": ">=17.0.1"
  }
}
