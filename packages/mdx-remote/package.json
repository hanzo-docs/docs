{
  "name": "@hanzo/docs-mdx-remote",
  "version": "1.4.6",
  "description": "The remote MDX files adapter for Hanzo Docs",
  "keywords": [
    "Docs",
    "Hanzo Docs"
  ],
  "homepage": "https://docs.hanzo.ai",
  "license": "MIT",
  "author": "Hanzo Nama",
  "repository": "github:hanzoai/docs",
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "catalog:",
    "js-yaml": "catalog:",
    "unified": "catalog:",
    "vfile": "catalog:"
  },
  "devDependencies": {
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@hanzo/docs-core": "workspace:*",
    "react": "catalog:",
    "tinyglobby": "catalog:",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@types/mdx": ">=2",
    "@types/react": ">=19.2.18",
    "@hanzo/docs-core": ">=17.0.1",
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@types/mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
